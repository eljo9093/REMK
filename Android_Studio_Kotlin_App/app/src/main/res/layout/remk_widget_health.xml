<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/remk_widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/remk_w_note_box_bg"
        android:padding="10dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤️ RE:MK VITAL, SCHRITTE &amp; COACH-STEUERUNG"
            android:textColor="#FF5E00"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_health_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="👟 0 Schritte heute  •  🔥 0 kcal Aktivität"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/remk_w_row_inactive_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/w_health_vitals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="❤️ 62 BPM   |   😴 7,5 Std. Schlaf   |   ⚡ 92% Readiness"
            android:textColor="#CBD5E1"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_w_toggle_coach"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.15"
            android:background="@drawable/remk_w_popup_btn_bg"
            android:gravity="center"
            android:text="🗣️🔥 Coach: AN"
            android:textColor="#FF5E00"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_start_timer"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_pill_green"
            android:gravity="center"
            android:text="⏱️ 90s Timer"
            android:textColor="#10B981"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_open_health"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.85"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_pill_blue"
            android:gravity="center"
            android:text="❤️ Vital"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
