<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/remk_w_cyber_bg"
    android:padding="11dp">

    <LinearLayout
        android:id="@+id/w_cal_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/remk_w_cyber_panel"
        android:padding="9dp"
        android:layout_marginBottom="6dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📅 RE:MK KALENDER · HEUTE" android:textColor="#FF00D4FF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/btn_cal_open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/remk_w_cyber_badge" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="⚙️ Zeiten" android:textColor="#FFE0F7FF" android:textSize="9.5sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_cal_today_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🏋️ Heute · 17:30 Uhr"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_cal_today_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Dein geplanter Fokus heute"
            android:textColor="#FF94A3B8"
            android:textSize="10.5sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/remk_w_cyber_panel"
        android:padding="9dp"
        android:layout_marginBottom="6dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NÄCHSTE EINHEITEN" android:textColor="#FF94A3B8" android:textSize="9sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
        <TextView android:id="@+id/w_cal_next_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="• Mi 17:30 · 🏋️ Gym" android:textColor="#FFE2E8F0" android:textSize="10.5sp" android:textStyle="bold" android:paddingBottom="3dp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_cal_next_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="• Fr 17:30 · 🏋️ Gym" android:textColor="#FFCBD5E1" android:textSize="10.5sp" android:paddingBottom="3dp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_cal_next_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="• Mo 17:30 · 🛋️ Zuhause" android:textColor="#FF94A3B8" android:textSize="10.5sp" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cal_start_workout"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/remk_w_cyber_bonus_bg"
            android:gravity="center"
            android:text="▶️ Training"
            android:textColor="#FFFFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_cal_add_activity"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/remk_w_cyber_badge"
            android:gravity="center"
            android:text="➕ Aktivität"
            android:textColor="#FF00D4FF"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
