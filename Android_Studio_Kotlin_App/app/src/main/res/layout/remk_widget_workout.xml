<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/remk_widget_bg"
    android:padding="12dp">

    <!-- 1. TOP ORANGE-UMRANDETE NOTIZ-/GERÄTE-BOX WIE IM SCREENSHOT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/remk_w_note_box_bg"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_workout_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📝 Notiz / Gerät: Bankdrücken"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_w_start_workout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/remk_w_popup_btn_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="🔍 Popup"
                android:textColor="#FF5E00"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_workout_next_ex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/remk_w_note_inner_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="z. B. Sitz Stufe 4, Lehne Loch 2  •  ⚖️ Ziel: 80 kg × 10"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 2. SPALTENKÖPFE: # 🔧 | KG ✏️ | WDH | 1RM ✏️ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="# 🔧"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="KG ✏️"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="WDH"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1RM ✏️"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="✓"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. PILLEN-LEISTE: 💡 Startgewicht-Hilfe | — 2,5 kg | + 2,5 kg -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btn_w_starter_help"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1.35"
            android:background="@drawable/remk_w_pill_green"
            android:gravity="center"
            android:text="💡 Startgewicht-Hilfe"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_minus_weight"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="0.85"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_pill_slate"
            android:gravity="center"
            android:text="— 2,5 kg"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_plus_weight"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="0.85"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_pill_blue"
            android:gravity="center"
            android:text="+ 2,5 kg"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. AKTIVE SATZ-ZEILE 1 (LEUCHTENDER ORANGER RAHMEN + GRÜNER CHECK-BUTTON RECHTS) -->
    <LinearLayout
        android:id="@+id/w_set_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/remk_w_row_active_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/w_set1_num"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/remk_w_num_circle_active"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set1_kg"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="77,5"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set1_reps"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="10"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set1_1rm"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="103"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_complete_set_direct"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:background="@drawable/remk_w_check_green_sq"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. FOLGE-SATZ-ZEILE 2 (DUNKLE SLATE-CARD WIE IM SCREENSHOT) -->
    <LinearLayout
        android:id="@+id/w_set_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/remk_w_row_inactive_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/w_set2_num"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/remk_w_num_circle_inactive"
            android:gravity="center"
            android:text="2"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set2_kg"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="77,5"
            android:textColor="#CBD5E1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set2_reps"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="10"
            android:textColor="#CBD5E1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set2_1rm"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="103"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_complete_set_2"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:background="@drawable/remk_w_check_dim_sq"
            android:gravity="center"
            android:text="✓"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6. FOLGE-SATZ-ZEILE 3 (DUNKLE SLATE-CARD WIE IM SCREENSHOT) -->
    <LinearLayout
        android:id="@+id/w_set_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/remk_w_row_inactive_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/w_set3_num"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/remk_w_num_circle_inactive"
            android:gravity="center"
            android:text="3"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set3_kg"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="77,5"
            android:textColor="#CBD5E1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set3_reps"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="10"
            android:textColor="#CBD5E1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set3_1rm"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="103"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_complete_set_3"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:background="@drawable/remk_w_check_dim_sq"
            android:gravity="center"
            android:text="✓"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
