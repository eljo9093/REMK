<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/remk_widget_bg"
    android:padding="11dp">

    <!-- 1. TOP KOPFZEILE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/remk_w_note_box_bg"
        android:padding="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_workout_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏋️ Bankdrücken • Satz 1"
                android:textColor="@color/remk_w_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_w_prev_ex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/remk_w_popup_btn_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="‹"
                android:textColor="#FF00D4FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_w_next_ex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:background="@drawable/remk_w_popup_btn_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="›"
                android:textColor="#FF00D4FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_w_start_workout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/remk_w_popup_btn_bg"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="↗ App"
                android:textColor="#FF5E00"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_workout_next_ex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/remk_w_note_inner_bg"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="⚖️ Direkt ändern ohne App-Start • Zahl tippen = Eingabe"
            android:textColor="@color/remk_w_text_muted"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 2. DIREKT-STEUERUNG OHNE APP-START: -2,5 kg | +2,5 kg | -1 Wdh | +1 Wdh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btn_w_minus_weight"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/remk_w_pill_slate"
            android:gravity="center"
            android:text="−2,5 kg"
            android:textColor="@color/remk_w_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_plus_weight"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/remk_w_pill_blue"
            android:gravity="center"
            android:text="+2,5 kg"
            android:textColor="@color/remk_w_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_minus_reps"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/remk_w_pill_slate"
            android:gravity="center"
            android:text="−1 Wdh"
            android:textColor="@color/remk_w_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_plus_reps"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/remk_w_pill_green"
            android:gravity="center"
            android:text="+1 Wdh"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. SATZ-ZEILE 1 -->
    <LinearLayout
        android:id="@+id/w_set_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/remk_w_row_active_bg"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/w_set1_num"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/remk_w_num_circle_active"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/remk_w_text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set1_kg"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="80 kg ✏️"
            android:textColor="@color/remk_w_text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set1_reps"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="10 Wdh ✏️"
            android:textColor="@color/remk_w_text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set1_1rm"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="107"
            android:textColor="@color/remk_w_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_complete_set_direct"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:background="@drawable/remk_w_check_green_sq"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. SATZ-ZEILE 2 -->
    <LinearLayout
        android:id="@+id/w_set_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/remk_w_row_inactive_bg"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/w_set2_num"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/remk_w_num_circle_inactive"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/remk_w_text_muted"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set2_kg"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="80 kg"
            android:textColor="@color/remk_w_text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set2_reps"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="10 Wdh"
            android:textColor="@color/remk_w_text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set2_1rm"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="107"
            android:textColor="@color/remk_w_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_complete_set_2"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:background="@drawable/remk_w_check_dim_sq"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/remk_w_text_muted"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. SATZ-ZEILE 3 -->
    <LinearLayout
        android:id="@+id/w_set_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/remk_w_row_inactive_bg"
        android:paddingStart="9dp"
        android:paddingEnd="9dp">

        <TextView
            android:id="@+id/w_set3_num"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/remk_w_num_circle_inactive"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/remk_w_text_muted"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set3_kg"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="80 kg"
            android:textColor="@color/remk_w_text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set3_reps"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/remk_w_value_pill_bg"
            android:gravity="center"
            android:text="10 Wdh"
            android:textColor="@color/remk_w_text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_set3_1rm"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="107"
            android:textColor="@color/remk_w_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_complete_set_3"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:background="@drawable/remk_w_check_dim_sq"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/remk_w_text_muted"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
