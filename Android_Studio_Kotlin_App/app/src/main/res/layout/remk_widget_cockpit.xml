<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/remk_w_cyber_bg"
    android:padding="10dp">

    <!-- 1. OBSIDIAN-CYBER STATUS-KOPF (LV. XX + RANG + ANSICHT-SWITCH + LOCK) -->
    <LinearLayout
        android:id="@+id/w_ck_header_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/remk_w_cyber_panel"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="7dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_ck_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LV. 24"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_ck_rank"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/remk_w_cyber_badge"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="A-RANG ATHLET"
                android:textColor="#FFE0F7FF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_ck_toggle_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/remk_w_cyber_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="📊 6-Axis"
                android:textColor="#FF00D4FF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_ck_lockscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/remk_w_cyber_bonus_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="🔒"
                android:textColor="#FFFFEDD5"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="5dp">
            <ProgressBar
                android:id="@+id/w_ck_xp_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="68"
                android:progressDrawable="@drawable/remk_w_cyber_xp_bar" />
            <TextView
                android:id="@+id/w_ck_xp_line"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1.840 / 2.200 XP"
                android:textColor="#FFFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </FrameLayout>

        <TextView
            android:id="@+id/w_ck_dots_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="DOTS · 80 KG · ACWR 1,05 🟢"
            android:textColor="#FF94A3B8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 2. LEBENDIGE 2-SPALTEN-MITTE (LINKS: DREHBARE 3D-FIGUR PER TAP | RECHTS: 6 ACHSEN) -->
    <LinearLayout
        android:id="@+id/w_ck_mid_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp">

        <LinearLayout
            android:id="@+id/btn_ck_rotate_body"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.88"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/w_ck_body_img"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="RE:MK 3D Athlet drehbar" />

            <TextView
                android:id="@+id/w_ck_angle_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/remk_w_cyber_badge"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="↻ Vorne"
                android:textColor="#FF00D4FF"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_ck_lbl_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="STR Kraft" android:textColor="#FFE2E8F0" android:textSize="9.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_str" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="78" android:textColor="#FF00D4FF" android:textSize="9.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_str" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="1dp" android:layout_marginBottom="4dp" android:max="100" android:progress="78" android:progressDrawable="@drawable/remk_w_cyber_stat_cyan" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_ck_lbl_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ATH Athletik" android:textColor="#FFE2E8F0" android:textSize="9.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_ath" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="74" android:textColor="#FFFF5E00" android:textSize="9.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_ath" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="1dp" android:layout_marginBottom="4dp" android:max="100" android:progress="74" android:progressDrawable="@drawable/remk_w_cyber_stat_orange" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_ck_lbl_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="END Ausdauer" android:textColor="#FFE2E8F0" android:textSize="9.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="72" android:textColor="#FF10B981" android:textSize="9.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_end" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="1dp" android:layout_marginBottom="4dp" android:max="100" android:progress="72" android:progressDrawable="@drawable/remk_w_cyber_stat_green" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_ck_lbl_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MOB Mobility" android:textColor="#FFE2E8F0" android:textSize="9.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_vit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="70" android:textColor="#FF38BDF8" android:textSize="9.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_vit" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="1dp" android:layout_marginBottom="4dp" android:max="100" android:progress="70" android:progressDrawable="@drawable/remk_w_cyber_stat_blue" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_ck_lbl_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="REC Erholung" android:textColor="#FFE2E8F0" android:textSize="9.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_rec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="86" android:textColor="#FFA855F7" android:textSize="9.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_rec" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="1dp" android:layout_marginBottom="4dp" android:max="100" android:progress="86" android:progressDrawable="@drawable/remk_w_cyber_stat_purple" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_ck_lbl_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CON Konstanz" android:textColor="#FFE2E8F0" android:textSize="9.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_con" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="88" android:textColor="#FFF59E0B" android:textSize="9.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_con" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="1dp" android:max="100" android:progress="88" android:progressDrawable="@drawable/remk_w_cyber_stat_orange" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. INTERAKTIVE QUICK-LEISTE (WASSER +250ML | SATZ ✓ | +AKTIVITÄT | EINKAUF) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <LinearLayout
            android:id="@+id/btn_ck_water"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/remk_w_cyber_panel"
            android:padding="6dp"
            android:layout_marginEnd="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧 +250ml" android:textColor="#FF94A3B8" android:textSize="8.5sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_ck_water" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2,2 / 2,8 L" android:textColor="#FF00D4FF" android:textSize="10sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_ck_complete_set"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:background="@drawable/remk_w_cyber_panel"
            android:padding="6dp"
            android:layout_marginEnd="4dp">
            <TextView android:id="@+id/w_ck_workout_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🏋️ Bankdrücken" android:textColor="#FF10B981" android:textSize="8.5sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/w_ck_workout_set" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓ 80 kg × 10" android:textColor="#FFF1F5F9" android:textSize="10sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_ck_shop_quick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical"
            android:background="@drawable/remk_w_cyber_panel"
            android:padding="6dp">
            <TextView android:id="@+id/w_ck_kcal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛒 +Einkauf" android:textColor="#FF94A3B8" android:textSize="8.5sp" android:textStyle="bold" android:singleLine="true" />
            <TextView android:id="@+id/w_ck_shop_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Offen" android:textColor="#FFF8FAFC" android:textSize="10sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. 3 EINZELN ABHAKBARE TÄGLICHE MISSIONEN + BONUS-BANNER -->
    <LinearLayout
        android:id="@+id/w_ck_quest_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/remk_w_cyber_panel"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="3dp">
            <TextView android:id="@+id/w_ck_quest_head" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TÄGLICHE MISSIONEN (ANTIPPEN = ✓)" android:textColor="#FFF8FAFC" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_ck_steps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👟 8.420" android:textColor="#FF10B981" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/btn_ck_m1" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="○ Mission 1" android:textColor="#FFE2E8F0" android:textSize="10sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/btn_ck_m2" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="○ Mission 2" android:textColor="#FFE2E8F0" android:textSize="10sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/btn_ck_m3" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="○ Mission 3" android:textColor="#FFE2E8F0" android:textSize="10sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />

        <TextView
            android:id="@+id/w_ck_bonus_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/remk_w_cyber_bonus_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="⚡ + Kurs, Verein oder Finisher loggen"
            android:textColor="#FFFFEDD5"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
