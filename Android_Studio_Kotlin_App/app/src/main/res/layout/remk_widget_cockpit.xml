<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/remk_w_cyber_bg"
    android:padding="11dp">

    <!-- 1. OBSIDIAN-CYBER STATUS-KOPF (LV. XX + CYAN RANG-BADGE + XP-BALKEN) -->
    <LinearLayout
        android:id="@+id/w_ck_header_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/remk_w_cyber_panel"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="9dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_ck_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LV. 24"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_ck_rank"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/remk_w_cyber_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="A-RANG ATHLET"
                android:textColor="#FFE0F7FF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_ck_lockscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/remk_w_cyber_bonus_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="🔒 Lock"
                android:textColor="#FFFFEDD5"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="6dp">
            <ProgressBar
                android:id="@+id/w_ck_xp_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="68"
                android:progressDrawable="@drawable/remk_w_cyber_xp_bar" />
            <TextView
                android:id="@+id/w_ck_xp_line"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1.840 / 2.200 XP"
                android:textColor="#FFFFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </FrameLayout>

        <TextView
            android:id="@+id/w_ck_dots_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="DOTS · 80 KG · ACWR 1,05 🟢"
            android:textColor="#FF94A3B8"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 2. OFFENE 2-SPALTEN-MITTE (LINKS: 3D-ANATOMIE | RECHTS: 5 STATUS-BALKEN) -->
    <LinearLayout
        android:id="@+id/w_ck_mid_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/w_ck_body_img"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.88"
            android:src="@drawable/remk_w_cockpit_body_m"
            android:scaleType="fitCenter"
            android:contentDescription="RE:MK 3D Athlet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <!-- STR -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="STR Kraft" android:textColor="#FFE2E8F0" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_str" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="78" android:textColor="#FF00D4FF" android:textSize="10.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_str" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:layout_marginBottom="5dp" android:max="100" android:progress="78" android:progressDrawable="@drawable/remk_w_cyber_stat_cyan" />

            <!-- END -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="END Ausdauer" android:textColor="#FFE2E8F0" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="72" android:textColor="#FF10B981" android:textSize="10.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_end" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:layout_marginBottom="5dp" android:max="100" android:progress="72" android:progressDrawable="@drawable/remk_w_cyber_stat_green" />

            <!-- VIT -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="VIT Ernährung" android:textColor="#FFE2E8F0" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_vit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="84" android:textColor="#FF38BDF8" android:textSize="10.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_vit" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:layout_marginBottom="5dp" android:max="100" android:progress="84" android:progressDrawable="@drawable/remk_w_cyber_stat_blue" />

            <!-- REC -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="REC Erholung" android:textColor="#FFE2E8F0" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_rec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="86" android:textColor="#FFA855F7" android:textSize="10.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_rec" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:layout_marginBottom="5dp" android:max="100" android:progress="86" android:progressDrawable="@drawable/remk_w_cyber_stat_purple" />

            <!-- CON -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CON Disziplin" android:textColor="#FFE2E8F0" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_ck_val_con" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="88" android:textColor="#FFFF5E00" android:textSize="10.5sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_ck_bar_con" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp" android:max="100" android:progress="88" android:progressDrawable="@drawable/remk_w_cyber_stat_orange" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. INTERAKTIVE QUICK-LEISTE (WASSER +250ML | SATZ ✓ | EINKAUF +TEXT) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:id="@+id/btn_ck_water"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/remk_w_cyber_panel"
            android:padding="7dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧 +250ml"
                android:textColor="#FF94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_ck_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2,2 / 2,8 L"
                android:textColor="#FF00D4FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_ck_complete_set"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.25"
            android:orientation="vertical"
            android:background="@drawable/remk_w_cyber_panel"
            android:padding="7dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:id="@+id/w_ck_workout_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏋️ Bankdrücken"
                android:textColor="#FF10B981"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/w_ck_workout_set"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ 80 kg × 10"
                android:textColor="#FFF1F5F9"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_ck_shop_quick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:orientation="vertical"
            android:background="@drawable/remk_w_cyber_panel"
            android:padding="7dp">
            <TextView
                android:id="@+id/w_ck_kcal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒 +Einkauf"
                android:textColor="#FF94A3B8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:id="@+id/w_ck_shop_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offen"
                android:textColor="#FFF8FAFC"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. TÄGLICHE MISSIONEN + ORANGE BONUS-BANNER -->
    <LinearLayout
        android:id="@+id/w_ck_quest_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/remk_w_cyber_panel"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/w_ck_quest_head"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TÄGLICHE MISSIONEN"
                android:textColor="#FFF8FAFC"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_ck_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👟 8.420"
                android:textColor="#FF10B981"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_ck_quest_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="○ Wasser · ○ Protein · ○ Workout / 8k"
            android:textColor="#FFCBD5E1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_ck_bonus_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/remk_w_cyber_bonus_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="⚡ BONUS: Tages-Fokus aktiv"
            android:textColor="#FFFFEDD5"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
