<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/remk_widget_bg"
    android:padding="12dp">

    <!-- 1. TOP ORANGE-UMRANDETE EINKAUFS- & GPS-BOX -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/remk_w_note_box_bg"
        android:padding="10dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_endurance_kpi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒 LIVE-EINKAUFSLISTE (1-TAP = ✓)"
                android:textColor="#FF5E00"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_endurance_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Antippen hakt Artikel sofort ab &amp; rückt nach"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_w_run"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/remk_w_popup_btn_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="🛒 Liste"
            android:textColor="#FF5E00"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. 3 FULL-BLEED EINKAUFS-ZEILEN IM SCREENSHOT-CARD-LOOK -->
    <TextView
        android:id="@+id/btn_shop_item_0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="5dp"
        android:background="@drawable/remk_w_row_active_bg"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="☐ 1,2 kg Geflügelbrustfilet (Hähnchen / Pute)"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/btn_shop_item_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="5dp"
        android:background="@drawable/remk_w_row_inactive_bg"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="☐ 1,5 kg Magerquark / Skyr Natur"
        android:textColor="#CBD5E1"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/btn_shop_item_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="6dp"
        android:background="@drawable/remk_w_row_inactive_bg"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="☐ 750 g Basmatireis &amp; Haferflocken"
        android:textColor="#CBD5E1"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- 3. UNTERE PILLEN-LEISTE FÜR GPS-LAUF & RAD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_w_walk"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/remk_w_pill_green"
            android:gravity="center"
            android:text="🏃🗺️ GPS-Lauf starten"
            android:textColor="#10B981"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_w_bike"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/remk_w_pill_blue"
            android:gravity="center"
            android:text="🚴🗺️ GPS-Radtour"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
